# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron job secret (random string — add to Vercel env vars too)
CRON_SECRET=your-random-secret-here

# PayFast (payment gateway)
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
PAYFAST_SANDBOX=true
SUBSCRIPTION_PRICE_ZAR=349.99

# EFT (alternative manual payment method shown on /subscribe/eft).
# When any of bank/holder/account/branch is unset, the EFT page shows a
# "bank details not configured" warning. Activation is manual — admin sees
# the deposit (with the shop code as reference) and activates the shop
# from /admin/shops/[id]. No webhook or auto-confirmation.
EFT_BANK_NAME=
EFT_ACCOUNT_HOLDER=
EFT_ACCOUNT_NUMBER=
EFT_BRANCH_CODE=
EFT_ACCOUNT_TYPE=Cheque

# External API (server-to-server Bearer token for business portal)
EXTERNAL_API_KEY=your-random-api-key-here

# App URL (used for PayFast return/notify URLs)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
